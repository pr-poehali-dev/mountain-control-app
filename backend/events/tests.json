{
  "tests": [
    {
      "name": "Get events",
      "method": "GET",
      "path": "/?action=list",
      "expectedStatus": 200
    },
    {
      "name": "Get dashboard",
      "method": "GET",
      "path": "/?action=dashboard",
      "expectedStatus": 200
    },
    {
      "name": "Get notifications",
      "method": "GET",
      "path": "/?action=notifications",
      "expectedStatus": 200
    },
    {
      "name": "Mark read requires id",
      "method": "PUT",
      "path": "/?action=read",
      "body": {},
      "expectedStatus": 400
    },
    {
      "name": "Mark all read",
      "method": "PUT",
      "path": "/?action=read-all",
      "body": {},
      "expectedStatus": 200
    },
    {
      "name": "Edit requires admin",
      "method": "PUT",
      "path": "/?action=edit",
      "body": {
        "id": 1,
        "description": "x"
      },
      "expectedStatus": 403
    },
    {
      "name": "Hide requires admin",
      "method": "PUT",
      "path": "/?action=hide",
      "body": {
        "id": 1
      },
      "expectedStatus": 403
    },
    {
      "name": "Expiring passes",
      "method": "GET",
      "path": "/?action=expiring-passes",
      "expectedStatus": 200
    },
    {
      "name": "Alert settings admin only",
      "method": "GET",
      "path": "/?action=pass-alert-settings",
      "expectedStatus": 403
    },
    {
      "name": "Alert auto",
      "method": "GET",
      "path": "/?action=pass-alert-auto",
      "expectedStatus": 200
    },
    {
      "name": "Pass registry vehicles",
      "method": "GET",
      "path": "/?action=pass-registry&kind=vehicle",
      "expectedStatus": 200,
      "expectedBody": {
        "kind": "vehicle"
      },
      "bodyMatcher": "partial"
    },
    {
      "name": "Not passed list",
      "method": "GET",
      "path": "/?action=not-passed",
      "expectedStatus": 200
    }
  ]
}