{
  "tests": [
    {
      "name": "Get stats",
      "method": "GET",
      "path": "/?action=stats",
      "expectedStatus": 200
    },
    {
      "name": "Get journal",
      "method": "GET",
      "path": "/?action=journal",
      "expectedStatus": 200
    },
    {
      "name": "Pass without code returns error",
      "method": "POST",
      "path": "/?action=pass",
      "body": {},
      "expectedStatus": 400
    },
    {
      "name": "Get on-site list",
      "method": "GET",
      "path": "/?action=on-site",
      "expectedStatus": 200
    },
    {
      "name": "Export journal",
      "method": "GET",
      "path": "/?action=export",
      "expectedStatus": 200
    },
    {
      "name": "Update without admin forbidden",
      "method": "PUT",
      "path": "/?action=pass-update",
      "body": {
        "id": 1,
        "notes": "x"
      },
      "expectedStatus": 403
    },
    {
      "name": "Delete without admin forbidden",
      "method": "DELETE",
      "path": "/?action=pass-delete",
      "body": {
        "id": 1
      },
      "expectedStatus": 403
    }
  ]
}